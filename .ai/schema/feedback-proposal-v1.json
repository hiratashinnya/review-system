{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hiratashinnya/review-system/schemas/feedback-proposal-v1.json",
  "title": "review-system feedback proposal/v1",
  "description": "Asset-revision proposal derived from ledger entries, stored as canonical TOML under .ai/feedback/queue/. This JSON is documentation and validation metadata; the executable validator is hand-written in feedback_ledger/ and depends on the standard library only. Date-typed fields are TOML local dates and appear here as strings; fields that may be empty until a decision is made (decided_at, alongside decided_in) spell the empty case out in their pattern rather than relying on `format: date`, which is an annotation only and would not tell a reader that the empty string is a legal value.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "id", "derived_from", "target_assets", "target_kind", "routing",
    "status", "proposed_at", "decided_in", "decided_by", "decided_at",
    "decision_reason", "issue_ref", "applied_pr", "body"
  ],
  "properties": {
    "schema": {"const": "feedback-proposal/v1"},
    "id": {"type": "string", "pattern": "^FBP-[0-9]{8}-[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "derived_from": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^FBK-[0-9]{8}-[a-z0-9]+(?:-[a-z0-9]+)*$"}
    },
    "target_assets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "target_kind": {"enum": ["contract", "criteria", "governance", "tooling"]},
    "routing": {
      "enum": ["issue", "node"],
      "description": "Must agree with the harness-classification table in .claude/rules/02-decision-process.md (rule P4)."
    },
    "status": {"enum": ["pending", "approved", "rejected", "applied", "superseded"]},
    "proposed_at": {"type": "string", "format": "date"},
    "decided_in": {
      "type": "string",
      "pattern": "^(?:|TRG-[0-9]{4}-W[0-9]{2})$"
    },
    "decided_by": {"type": "string"},
    "decided_at": {
      "type": "string",
      "pattern": "^(?:|[0-9]{4}-[0-9]{2}-[0-9]{2})$",
      "description": "Empty until the proposal is decided; a plain ISO date afterwards. Required to be non-empty when status is approved (see allOf)."
    },
    "decision_reason": {"type": "string"},
    "issue_ref": {"type": "string"},
    "applied_pr": {"type": "integer", "minimum": 0},
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": ["problem", "proposed_change", "rationale"],
      "properties": {
        "problem": {"type": "string", "minLength": 1},
        "proposed_change": {"type": "string", "minLength": 1},
        "rationale": {"type": "string", "minLength": 1}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "approved"}}, "required": ["status"]},
      "then": {
        "properties": {
          "decided_by": {"minLength": 1},
          "decided_in": {"minLength": 1},
          "decided_at": {"minLength": 1}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "rejected"}}, "required": ["status"]},
      "then": {"properties": {"decision_reason": {"minLength": 1}}}
    },
    {
      "if": {"properties": {"status": {"const": "applied"}}, "required": ["status"]},
      "then": {
        "properties": {
          "issue_ref": {"minLength": 1},
          "applied_pr": {"minimum": 1}
        }
      }
    }
  ]
}
