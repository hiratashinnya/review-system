{
  "schema": "triage-policy/v1",
  "policy_id": "review-finding-disposition",
  "policy_version": "1.0",
  "status": "draft",
  "auto_apply_enabled": false,
  "enabled_phases": [
    "review",
    "remediation_review"
  ],
  "feature_flags": {
    "fix-here": false,
    "deferred": false,
    "advisory": false
  },
  "rules": [
    {
      "outcome": "fix-here",
      "all_true": [],
      "all_false": [],
      "any_true": [
        "ac_violation",
        "design_violation",
        "contract_violation",
        "regression"
      ],
      "equals": {}
    },
    {
      "outcome": "deferred",
      "all_true": [
        "preexisting"
      ],
      "all_false": [
        "ac_violation",
        "design_violation",
        "contract_violation",
        "regression",
        "worsened",
        "high_risk"
      ],
      "any_true": [],
      "equals": {
        "severity": "minor"
      }
    },
    {
      "outcome": "advisory",
      "all_true": [
        "optional_improvement"
      ],
      "all_false": [
        "ac_violation",
        "design_violation",
        "contract_violation",
        "regression"
      ],
      "any_true": [],
      "equals": {
        "harm": "none"
      }
    }
  ]
}
