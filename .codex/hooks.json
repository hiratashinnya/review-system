{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(?:Bash|codex_apps\\.github\\.merge_pull_request|codex_apps\\.github\\.enable_auto_merge|mcp__codex_apps__github_merge_pull_request|mcp__codex_apps__github_enable_auto_merge|mcp__github__merge_pull_request|mcp__github__enable_auto_merge|mcp__github__enable_pull_request_auto_merge|github_merge_pull_request|github_enable_auto_merge)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/pr-merge-gate.sh\"",
            "timeout": 120,
            "statusMessage": "Fresh-checking blockers before PR merge"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/agent-command-gate.sh\"",
            "timeout": 15,
            "statusMessage": "Enforcing issue-implementer/pr-reviewer push/merge boundary"
          }
        ]
      },
      {
        "matcher": "^(?:spawn_agent|Agent|collaborationspawn_agent)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/issue-start-gate.sh\"",
            "timeout": 45,
            "statusMessage": "Checking blocker evidence before Issue dispatch"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(?:Bash|codex_apps\\.github\\.merge_pull_request|codex_apps\\.github\\.enable_auto_merge|mcp__codex_apps__github_merge_pull_request|mcp__codex_apps__github_enable_auto_merge|mcp__github__merge_pull_request|mcp__github__enable_auto_merge|mcp__github__enable_pull_request_auto_merge|github_merge_pull_request|github_enable_auto_merge)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/pr-merge-gate.sh\"",
            "timeout": 30,
            "statusMessage": "Recording managed PR merge response"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/codex-rate-limit-stop-hook.sh\"",
            "timeout": 15,
            "statusMessage": "Checking Codex rate-limit status"
          }
        ]
      }
    ]
  }
}
