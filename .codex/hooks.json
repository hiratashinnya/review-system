{
  "hooks": {
    "SubagentStart": [
      {
        "matcher": "agy-delegate",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/agy-reference-context.py\"",
            "timeout": 15,
            "additionalContextLimit": 0,
            "statusMessage": "Loading agy delegate references"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/agent-command-gate.sh\"",
            "timeout": 15,
            "statusMessage": "Enforcing issue-implementer/pr-reviewer push boundary"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/adr-notify.sh\"",
            "timeout": 15,
            "statusMessage": "Checking pending ADR issue tracking"
          }
        ]
      }
    ]
  }
}
