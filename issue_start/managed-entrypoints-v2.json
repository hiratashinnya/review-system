{
  "schema_version": "managed-issue-entrypoints/2",
  "policy_version": "issue-start/1.0",
  "codex_supervisor_launch": {
    "schema_version": "codex-launch-intent/1",
    "change_plan_schema": "codex-change-plan/2",
    "change_plan_root": "tmp/_codex_control/change-plans",
    "canonical_ledger_platform": "codex-supervisor",
    "reservation_contract": "same-entry/intent-digest-v1",
    "issuer_contract": {
      "schema_version": "codex-change-plan-issuance/1",
      "command": "python3 -m issue_start.codex_launch_control issue",
      "sources_root": "tmp/_codex_control/sources"
    },
    "roles": {
      "issue-implementer": {
        "model": "gpt-5.6-sol",
        "reasoning_effort": "xhigh",
        "task_key_template": "issue_{issue}",
        "handoff_template": "tmp/_handoff/issue-implementer--issue-{issue}.yaml",
        "prompt_template": "Implement Issue #{issue} under owner-approved change plan {change_plan_id}. Verified Issue and Acceptance Criteria snapshot follows:\n\n{issue_snapshot}"
      },
      "issue-fixer": {
        "model": "gpt-5.6-sol",
        "reasoning_effort": "xhigh",
        "task_key_template": "issue_{issue}_fix_r{round}",
        "handoff_template": "tmp/_handoff/issue-fixer--issue-{issue}-r{round}.yaml",
        "prompt_template": "Fix findings {finding_ids} for Issue #{issue} under owner-approved change plan {change_plan_id}. Verified Issue and Acceptance Criteria snapshot follows:\n\n{issue_snapshot}\n\nVerified finding karte ({karte_path}) follows:\n\n{karte_snapshot}"
      }
    },
    "executables": {
      "bwrap": "/usr/bin/bwrap",
      "codex": {
        "lookup_name": "codex",
        "sandbox_alias": "/run/issue-supervised/codex"
      }
    },
    "runtime_root_template": "tmp/_codex_sessions/{task_key}/runtime-home",
    "permission_profile": "issue-supervised"
  },
  "managed": [
    {
      "entrypoint": "issue-pipeline",
      "agent_type": "issue-implementer",
      "binding_transports": {
        "claude": {
          "tool_names": [
            "Task",
            "Agent"
          ],
          "agent_type_field": "subagent_type",
          "required_tool_input_fields": [
            "subagent_type",
            "prompt"
          ],
          "forbidden_tool_input_fields": [
            "agent_type",
            "message",
            "task_name"
          ],
          "prompt_field": "prompt",
          "binding_marker": "ISSUE_START_BINDING_V1=",
          "required_isolation": "worktree"
        }
      }
    }
  ],
  "isolation_only": [
    {
      "entrypoint": "issue-pipeline",
      "agent_type": "issue-fixer",
      "binding_transports": {
        "claude": {
          "tool_names": [
            "Task",
            "Agent"
          ],
          "agent_type_field": "subagent_type",
          "required_tool_input_fields": [
            "subagent_type",
            "prompt"
          ],
          "forbidden_tool_input_fields": [
            "agent_type",
            "message",
            "task_name"
          ],
          "prompt_field": "prompt",
          "binding_marker": "ISSUE_FIX_BINDING_V1=",
          "required_isolation": "worktree"
        }
      }
    }
  ],
  "unmanaged": [
    "direct shell/API invocation outside issue-pipeline",
    "harnesses that do not enable/trust project PreToolUse hooks"
  ]
}
